# UrsBiz — Frontend Environment Variables
# Copy this file to .env.local and edit as needed.
# All NEXT_PUBLIC_ variables are exposed to the browser.

# ----- Application -----
NEXT_PUBLIC_APP_NAME=UrsBiz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Backend API -----
# In development, leave NEXT_PUBLIC_API_URL unset (commented out).
# The Next.js rewrite proxy (/api/v1/* → backend) handles routing
# automatically and keeps auth cookies same-origin (SameSite=lax safe).
#
# Only set this for Docker, staging, or production direct-connection.
# Canonical dev backend port is 8001. Keep this unset in development
# so the rewrite proxy handles routing and auth cookies stay same-origin.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001