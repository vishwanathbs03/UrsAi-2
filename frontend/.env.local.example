# UrsBiz — Frontend Environment Variables
# Copy this file to .env.local and edit as needed.
# All NEXT_PUBLIC_ variables are exposed to the browser.

# ----- Application -----
NEXT_PUBLIC_APP_NAME=UrsBiz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Backend API -----
# Must point to the FastAPI backend (port 8001 by default).
# Change if your backend runs on a different host or port.
NEXT_PUBLIC_API_URL=http://localhost:8001