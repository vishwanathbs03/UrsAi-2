# =============================================================================
# UrsBiz — Root .gitignore
# Comprehensive coverage: Python, FastAPI, Node, Next.js, databases,
# env files, logs, caches, cookies, tokens, generated files, IDE, OS.
# =============================================================================

# ----------------------- Python / FastAPI ----------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ----------------------- Node / Next.js ------------------------- #
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----------------------- Environment files ---------------------- #
.env
.env.local
.env.*.local
!.env.example
!.env.local.example
!.env.production.example
!.env.staging.example

# ----------------------- Databases ------------------------------ #
*.db
*.sqlite
*.sqlite3

# ----------------------- Logs ----------------------------------- #
*.log
logs/
server.log
_authdebug.log

# ----------------------- Cookies / Tokens / Auth dumps ---------- #
cookies.txt

# ----------------------- Test & verification output ------------- #
# Root-level response / output dumps from curl or test scripts.
login_resp.json
login.json
reg.json
reg2.json
biz.json
biz2.json
chat.json
recs.json
roadmap.json
rules.json
decision.json
twin.json
cop_test.json
copilot.json
verify_out/

# Backend test artifacts
backend/out
backend/server.log
backend/_authdebug.log

# ----------------------- Temporary audit / debug files ---------- #
_audit*
e2e_debug.py
# e2e_verify.py is kept in scripts/ as reusable tooling
/e2e_verify.py
backend/e2e_verify.py

# ----------------------- One-off generation scripts ------------- #
generate_pptx.py
generate_project_structure_pdf.py

# ----------------------- IDE / Editor --------------------------- #
.vscode/
.idea/
*.swp
*.swo
*~

# ----------------------- OS ------------------------------------ #
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ----------------------- H5.5 Sprint Cleanup --------------------- #
# Windows absolute-path leaks (H5.5 — leaked from a previous
# verifier running under MSYS). Treat any directory named `c/` or
# `tmp/` under `frontend/` as generated build output, NOT source.
frontend/c/
frontend/tmp/

# Note: `.kilo/kilo.jsonc` is tracked because it was committed before
# any ignore rule covered it. Per H7.0 §3, the path is treated as
# agent-config and not part of the UrsBiz product. Do not rewrite git
# history to remove it.

# Catch-all for ANY tmp/build/dist directory anywhere in the tree.
# These are verifier or build outputs and must never be tracked.
**/tmp/
**/build/
**/dist/
**/__pycache__/

# Bundled verifier outputs (esbuild / tsc / node --inspect).
*.bundle.js
*.cjs
!scripts/**/*.cjs   # legitimate cjs scripts under scripts/ are OK
!frontend/**/*.cjs  # legitimate cjs modules under frontend/ are OK

# ----------------------- Playwright (H7.2 / Prompt 2) ------------------ #
# Runtime test artefacts — never part of the UrsBiz product. These were
# flagged in H7.0 §3 as not covered; covering them now so a Playwright
# rerun never commits binary screenshots / traces / videos.
test-results/
playwright-report/
frontend/playwright-report/
frontend/test-results/
# Cached browser binaries — Playwright installs them outside node_modules.
**/.playwright/
**/playwright/.cache/

# The e2e/ folder is tracked (specs are product), but the artefacts it
# produces are not.

# ----------------------- Local prompt / spec dumps ---------------- #
# Working copies of the URSBIZ Hackathon Execution Program docx are
# unzipped into scripts/docx.txt for agent reference. They are working
# artefacts, not product artefacts — never commit them.
scripts/docx.txt

# ----------------------- Agent / Scratch / Debug ------------------ #
.claude/
Aibackend
current-working-tree.txt
scripts/debug/

