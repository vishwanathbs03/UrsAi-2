# UrsBiz Backend — Environment Variables
# Copy this file to .env and edit as needed.
# -------------------------------------------------------
#
# Every key below is a real pydantic-settings field on
# ``app.config.settings.Settings`` (case-insensitive). Keys
# not present in the source code have been removed so the
# example file is 1:1 with the actual configuration surface.
# Production / staging overlays live in
# ``deployment/env/.env.production.example`` and
# ``deployment/env/.env.staging.example`` respectively.

# ----- Application -----
APP_NAME=UrsBiz
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
# IMPORTANT: run backend on port 8001 to match the frontend proxy default.
APP_PORT=8001

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Database -----
# Development: SQLite (zero-config, auto-created on startup).
DATABASE_URL=sqlite:///./atlas_ai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/ursbiz
# Echo every SQL statement to stdout (debug only, very noisy).
DB_ECHO=false

# ----- AI Provider -----
# "placeholder" = deterministic rule-based AI (no external service needed).
# "ollama"      = local Ollama LLM server (optional, requires Ollama installed).
AI_PROVIDER=placeholder
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=60

# ----- Authentication -----
# Generate a strong secret: openssl rand -hex 32
# CHANGE THIS before running in production!
JWT_SECRET_KEY=dev-secret-do-not-use-in-prod-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_PATH=/
COOKIE_MAX_AGE_SECONDS=3600

# ----- Trusted proxy / rate limiting -----
# nginx sits in front of the app and forwards X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated path:limit pairs.
RATE_LIMIT_ENDPOINT_OVERRIDES=/api/v1/business/ocr:10,/api/v1/business/ocr/apply:10,/api/v1/auth/login:10,/api/v1/auth/register:5

# ----- Request body limits -----
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=26214400

# ----- Security headers -----
SECURITY_HEADERS_ENABLED=true
# Set STRICT_TRANSPORT_SECURITY in production (e.g. "max-age=31536000; includeSubDomains")
STRICT_TRANSPORT_SECURITY=
STRICT_TRANSPORT_SECURITY_MAX_AGE=31536000
STRICT_TRANSPORT_SECURITY_INCLUDE_SUBDOMAINS=true
STRICT_TRANSPORT_SECURITY_PRELOAD=false
SECURITY_AUDIT_ENABLED=true

# ----- DB connection pool (used for non-SQLite) -----
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# ----- Performance -----
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESS_LEVEL=5
HEALTH_RESPONSE_CACHE_CONTROL=no-store, max-age=0
