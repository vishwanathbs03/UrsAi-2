# UrsBiz Backend — Environment Variables
# Copy this file to .env and edit as needed.
# -------------------------------------------------------

# ----- Application -----
APP_NAME=UrsBiz
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
# IMPORTANT: run backend on port 8001 to match the frontend proxy default.
APP_PORT=8001

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Database -----
# Development: SQLite (zero-config, auto-created on startup)
DATABASE_URL=sqlite:///./atlas_ai.db
DATABASE_ECHO=false

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/ursbiz

# ----- AI Provider -----
# "placeholder" = deterministic rule-based AI (no external service needed).
# "ollama"      = local Ollama LLM server (optional, requires Ollama installed).
AI_PROVIDER=placeholder
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=60

# ----- Authentication -----
# Generate a strong secret: openssl rand -hex 32
# CHANGE THIS before running in production!
JWT_SECRET_KEY=dev-secret-do-not-use-in-prod-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
