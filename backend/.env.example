# UrsBiz Backend — Environment Variables
# Copy this file to .env and edit as needed.
# -------------------------------------------------------
#
# Every key below is a real pydantic-settings field on
# ``app.config.settings.Settings`` (case-insensitive). Keys
# not present in the source code have been removed so the
# example file is 1:1 with the actual configuration surface.
# Production / staging overlays live in
# ``deployment/env/.env.production.example`` and
# ``deployment/env/.env.staging.example`` respectively.

# ----- Application -----
APP_NAME=UrsBiz
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
# IMPORTANT: run backend on port 8001 (canonical dev/staging/prod port).
# This must match the defaults in backend/app/config/settings.py,
# backend/gunicorn_conf.py, backend/entrypoint.sh, and the
# frontend/next.config.mjs proxy fallback (also 8001).
APP_PORT=8001

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Database -----
# Development: SQLite (zero-config, auto-created on startup).
DATABASE_URL=sqlite:///./ursbiz.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/ursbiz
# Echo every SQL statement to stdout (debug only, very noisy).
DB_ECHO=false

# ----- AI Provider -----
# "placeholder" = deterministic rule-based AI (no external service needed).
# "ollama"      = local Ollama LLM server (optional, requires Ollama installed).
# "openai_compatible" = any OpenAI-compatible endpoint (Gemini, Together, vLLM, etc.).
#
# AI_MODEL must be a VERIFIED working model on the chosen
# upstream.  The committed default in settings.py is
# "gemini-2.0-flash".  Earlier shipped values
# ("gemini-3.6-flash" — not a real model; "gemini-1.5-flash" —
# no longer reliably served) caused the factory to mark the
# upstream as "configured" while every chat call failed with
# 404.  Operators who override this MUST verify the model
# name on their key before running the judge demo.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_REQUIRE_SCHEMA=true
# Inner per-request timeout enforced by the provider's httpx client.
# Authoritative cap when the upstream truly hangs.
AI_REQUEST_TIMEOUT_SECONDS=60
# H8.11 — outer wall-clock cap on a single LLM call. Enforced by
# ``AssistantProviderService._call_with_hard_timeout`` ABOVE the
# provider's inner timeout. Must be > worst-case
# (cold-load + prompt-eval + generation) for the chosen
# provider/model/host. On a 5.9 GB Windows host running
# llama3.2:3b a full grounded-mode prompt (12-section schema,
# business snapshot, evidence registry, JSON generation) takes
# ~90 s end-to-end. Default is 120 s for slack; lower for fast
# cloud upstreams.
AI_HARD_CALL_TIMEOUT_SECONDS=150

# Ollama-specific knobs (only used when AI_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# H7.8C — additional AI tunables that were previously hard-coded
# constants inside the providers/chat layers. All four have safe
# defaults — leave them alone unless you have a reason to tune.
# AI_GROUNDING_THRESHOLD:  minimum server_grounding_score required for
#   a generative response to be accepted (0..100). Below this the
#   service falls back to the deterministic provider.
AI_GROUNDING_THRESHOLD=50
# AI_DEFAULT_MODE:         default chat mode when the request does not
#   specify one ("grounded" or "open"). "grounded" = evidence-bounded.
AI_DEFAULT_MODE=grounded
# AI_MAX_HISTORY_TURNS:    rolling context window size (assistant + user
#   turns replayed back into the model). 8 is the safe default.
AI_MAX_HISTORY_TURNS=8
# KNOWLEDGE_RETRIEVAL_TOP_K: number of KB articles surfaced alongside
#   the chat answer when the knowledge retriever is enabled.
KNOWLEDGE_RETRIEVAL_TOP_K=3

# ----- Authentication -----
# Generate a strong secret: openssl rand -hex 32
# CHANGE THIS before running in production!
JWT_SECRET_KEY=dev-secret-do-not-use-in-prod-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_PATH=/
COOKIE_MAX_AGE_SECONDS=3600

# ----- Trusted proxy / rate limiting -----
# nginx sits in front of the app and forwards X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated path:limit pairs.
RATE_LIMIT_ENDPOINT_OVERRIDES=/api/v1/business/ocr:10,/api/v1/business/ocr/apply:10,/api/v1/auth/login:10,/api/v1/auth/register:5

# ----- Request body limits -----
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=26214400

# ----- Security headers -----
SECURITY_HEADERS_ENABLED=true
# Set STRICT_TRANSPORT_SECURITY in production (e.g. "max-age=31536000; includeSubDomains")
STRICT_TRANSPORT_SECURITY=
STRICT_TRANSPORT_SECURITY_MAX_AGE=31536000
STRICT_TRANSPORT_SECURITY_INCLUDE_SUBDOMAINS=true
STRICT_TRANSPORT_SECURITY_PRELOAD=false
SECURITY_AUDIT_ENABLED=true

# ----- DB connection pool (used for non-SQLite) -----
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# ----- Performance -----
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESS_LEVEL=5
HEALTH_RESPONSE_CACHE_CONTROL=no-store, max-age=0
