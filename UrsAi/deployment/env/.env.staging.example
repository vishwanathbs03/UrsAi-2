# =============================================================================
# Atlas AI — Staging environment example.
#
# Copy to .env.staging for the staging deployment. Placeholders use the
# CHANGE_ME_* prefix so any accidental commit is obvious in code review.
# =============================================================================

# --- Application -------------------------------------------------------- #
APP_NAME=Atlas AI
APP_ENV=staging
APP_DEBUG=false
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=DEBUG

# --- CORS --------------------------------------------------------------- #
CORS_ORIGINS=https://staging.atlas.example.com,http://localhost:8080

# --- Database ----------------------------------------------------------- #
DATABASE_URL=sqlite:////var/lib/atlas-ai/atlas_ai.db
DATABASE_ECHO=false

# --- AI provider -------------------------------------------------------- #
AI_PROVIDER=placeholder
AI_API_KEY=CHANGE_ME_PROVIDER_KEY
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Auth --------------------------------------------------------------- #
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Gunicorn / uvicorn ------------------------------------------------- #
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_PRELOAD_APP=false
GUNICORN_LOGLEVEL=info
