# =============================================================================
# Atlas AI — Production environment example.
#
# Copy to .env.production and replace placeholders with the real values
# for the deployment. Do NOT commit the real file. This template
# deliberately uses placeholder markers like CHANGE_ME_* so a
# `git diff` makes any accidental commit obvious.
# =============================================================================

# --- Application -------------------------------------------------------- #
APP_NAME=Atlas AI
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------- #
# Comma-separated list of origins allowed to call the API. The nginx
# reverse proxy terminates the public hostname, so this should be the
# origin the browser sends (the https URL of the site).
CORS_ORIGINS=https://atlas.example.com,https://www.atlas.example.com

# --- Database ----------------------------------------------------------- #
# Atlas AI uses an on-disk SQLite file mounted from the named volume
# backend-data. The default below points at the canonical path inside
# the backend container. Override only if you mount the DB elsewhere.
DATABASE_URL=sqlite:////var/lib/atlas-ai/atlas_ai.db
DATABASE_ECHO=false

# --- AI provider -------------------------------------------------------- #
# Atlas AI ships a deterministic fallback so the layer works without an
# external model. The placeholder values below are the safe defaults.
AI_PROVIDER=placeholder
AI_API_KEY=CHANGE_ME_PROVIDER_KEY
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Auth --------------------------------------------------------------- #
# Generate a strong random key per environment (`openssl rand -hex 64`).
# Never reuse the dev / staging secret in production.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Gunicorn / uvicorn ------------------------------------------------- #
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_PRELOAD_APP=false
GUNICORN_LOGLEVEL=info
