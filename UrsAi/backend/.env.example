# ----- Application -----
APP_NAME=Atlas AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/atlas_ai
DATABASE_ECHO=false

# ----- AI (placeholder, not used yet) -----
AI_PROVIDER=placeholder
AI_API_KEY=

# ----- Authentication (Sprint 1 Part 3) -----
# Generate a strong secret in production: `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set true in production so cookies are only sent over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
